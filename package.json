{
  "name": "computer-science-learning-next",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "predev": "npm run generate:legacy-react && npm run generate:legacy-controllers && npm run translate:controller-strings && npm run build:legacy-css",
    "build": "npm run generate:legacy-react && npm run generate:legacy-controllers && npm run translate:controller-strings && npm run build:legacy-css && next build --webpack",
    "test": "npm run generate:legacy-react && npm run generate:legacy-controllers && npm run translate:controller-strings && npm run test:locales && npm run test:markup && npm run test:theme && npm run test:crypto",
    "test:locales": "node --test tests/locales.test.cjs",
    "test:markup": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:theme": "node --test tests/theme-contrast.test.cjs",
    "test:crypto": "node --experimental-strip-types --test tests/cryptography.test.cjs",
    "start": "next start",
    "lint": "eslint .",
    "build:legacy-css": "tailwindcss -i ./src/legacy/legacy-tailwind.css -o ./public/legacy/tailwind.css --minify",
    "generate:legacy-react": "python3 scripts/generate-native-pages.py",
    "generate:legacy-controllers": "python3 scripts/generate-native-controllers.py",
    "translate:controller-strings": "node scripts/translate-controller-strings.cjs"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@tailwindcss/cli": "latest",
    "@tailwindcss/postcss": "latest",
    "@eslint/eslintrc": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "latest",
    "typescript": "latest"
  }
}
